# ==============================================================================
# Retail & E-commerce Commercial Analytics Copilot - Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000

# Database Configuration (MySQL 8)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=retail_analytics
DB_USER=analytics_user
DB_PASSWORD=analytics_password_dev
DB_ROOT_PASSWORD=root_password_dev

# Read-Only Database User (Principle of Least Privilege for Text-to-SQL)
DB_READONLY_USER=analytics_ro
DB_READONLY_PASSWORD=analytics_ro_password_dev

# SQLite Local Fallback (Useful for testing without MySQL active)
USE_SQLITE_FALLBACK=false
SQLITE_DB_PATH=data/processed/retail_analytics.db

# LLM Configuration
# Options: ollama, openai, anthropic
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen2.5:7b-instruct
TEMPERATURE=0.0
TOP_P=0.9
MAX_TOKENS=2048

# Optional Cloud LLM API Keys (Leave empty if using Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# RAG & Embeddings Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_DIR=data/processed/vectorstore
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.45

# Guardrails & Security
SQL_QUERY_TIMEOUT_SECONDS=10
SQL_MAX_ROWS_RETURNED=100
MAX_AGENT_STEPS=6
MAX_AGENT_RETRIES=2
